{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://btae.local/schema/approval/v1", "title": "BTAE Approval", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "entity_id", "revision", "decision", "identity", "authorization_source", "timestamp", "risk_scope", "signature"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^APPROVAL-[A-Z0-9][A-Z0-9_-]*$"}, "entity_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"enum": ["approved", "rejected", "revoked"]}, "identity": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "authorization_source": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "format": "date-time"}, "risk_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "medium", "high"]}}, "supersedes": {"type": ["string", "null"]}, "signature": {"type": "string", "minLength": 1}},
  "allOf": [{"if": {"properties": {"decision": {"const": "revoked"}}, "required": ["decision"]}, "then": {"required": ["supersedes"], "properties": {"supersedes": {"type": "string", "pattern": "^APPROVAL-[A-Z0-9][A-Z0-9_-]*$"}}}}]
}
