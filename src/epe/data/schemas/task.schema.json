{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://btae.local/schema/task/v1", "title": "BTAE Task", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "type", "objective", "acceptance", "risk", "target_entities"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^TASK-"}, "type": {"enum": ["feature", "bugfix", "refactor", "exploration"]}, "objective": {"type": "string", "minLength": 1}, "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "risk": {"enum": ["low", "medium", "high"]}, "target_entities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "changeset": {"type": ["string", "null"]}, "status": {"enum": ["planned", "active", "completed", "aborted"]}, "revision": {"type": "integer", "minimum": 1}}
}
