{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://btae.local/schema/evidence/v1", "title": "BTAE Evidence", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "target_entities", "checker", "checker_version", "command", "cwd", "started_at", "finished_at", "result", "validity", "input_manifest", "artifacts", "environment", "provenance"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^EVIDENCE-"}, "run_id": {"type": "string", "pattern": "^RUN-"}, "task_id": {"type": ["string", "null"]}, "changeset_id": {"type": ["string", "null"]}, "target_entities": {"type": "array", "items": {"type": "string"}}, "checker": {"type": "string", "minLength": 1}, "checker_version": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "minLength": 1}, "finished_at": {"type": "string", "minLength": 1}, "exit_code": {"type": ["integer", "null"]}, "expected_exit_code": {"type": ["integer", "null"]}, "termination_reason": {"type": ["string", "null"]}, "result": {"enum": ["passed", "failed", "error", "not_run"]}, "validity": {"enum": ["valid", "stale", "invalid", "unknown"]}, "input_manifest": {"type": "object", "required": ["entries", "digest"], "additionalProperties": false, "properties": {"entries": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ephemeral": {"type": "boolean", "default": false}}}}, "environment": {"type": "object"}, "provenance": {"type": "object"}}
}
