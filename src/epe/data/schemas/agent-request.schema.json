{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btae.local/schema/agent-request/v1",
  "title": "EPE Agent Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "operation",
    "task_id",
    "target_entities",
    "write_scope",
    "parameters",
    "trusted_identity"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "start_implementation",
        "verify",
        "finalize"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9][A-Z0-9_-]*$"
    },
    "changeset_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CHANGE-[A-Z0-9][A-Z0-9_-]*$"
    },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_design_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "parameters": {
      "type": "object"
    },
    "trusted_identity": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol_version": {
      "const": "1"
    }
  }
}
