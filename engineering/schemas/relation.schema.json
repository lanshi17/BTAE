{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btae.local/schema/relation/v1",
  "title": "BTAE Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "to", "relation", "origin", "confidence", "verified"],
  "properties": {
    "from": {"type": "string"}, "to": {"type": "string"},
    "relation": {"enum": ["contains", "realizes", "specifies", "depends_on", "conforms_to", "verified_by", "evidenced_by", "constrained_by", "supersedes", "affects"]},
    "origin": {"type": "object", "required": ["type", "source"], "additionalProperties": true, "properties": {"type": {"enum": ["explicit", "static", "inferred"]}, "source": {"type": "string"}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "verified": {"type": "boolean"},
    "verification": {"type": "object", "required": ["verifier", "method", "timestamp", "version"], "additionalProperties": false, "properties": {"verifier": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}
  }
}
