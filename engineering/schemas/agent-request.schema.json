{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://btae.local/schema/agent-request/v1", "title": "EPE Agent Request", "type": "object", "additionalProperties": false,
  "required": ["request_id", "operation", "task_id", "target_entities", "write_scope", "parameters"],
  "properties": {"request_id": {"type": "string", "minLength": 1}, "operation": {"enum": ["start_implementation", "verify", "finalize"]}, "task_id": {"type": "string", "pattern": "^TASK-"}, "changeset_id": {"type": ["string", "null"]}, "target_entities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "expected_design_revision": {"type": ["string", "null"]}, "write_scope": {"type": "array", "items": {"type": "string"}}, "parameters": {"type": "object"}, "trusted_identity": {"type": ["object", "null"]}}
}
