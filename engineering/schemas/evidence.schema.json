{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://btae.local/schema/evidence/v1", "title": "BTAE Evidence", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "target_entities", "checker", "checker_version", "command", "cwd", "started_at", "finished_at", "result", "validity", "input_manifest", "artifacts", "environment", "provenance"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^EVIDENCE-"}, "run_id": {"type": "string", "pattern": "^RUN-"}, "task_id": {"type": ["string", "null"]}, "changeset_id": {"type": ["string", "null"]}, "target_entities": {"type": "array", "items": {"type": "string"}}, "checker": {"type": "string"}, "checker_version": {"type": "string"}, "command": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"}, "exit_code": {"type": ["integer", "null"]}, "termination_reason": {"type": ["string", "null"]}, "result": {"enum": ["passed", "failed", "error", "not_run"]}, "validity": {"enum": ["valid", "stale", "invalid", "unknown"]}, "input_manifest": {"type": "object"}, "artifacts": {"type": "array", "items": {"type": "object"}}, "environment": {"type": "object"}, "provenance": {"type": "object"}}
}
